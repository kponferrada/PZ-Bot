# ============================================================================
# PZ Tambayan Discord Bot — Configuration template
# Copy this file to `config.env` and fill in your values.
# NEVER commit config.env — it holds the bot token, RCON password and SFTP creds.
# ============================================================================

# --- Discord ----------------------------------------------------------------
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_GUILD_ID
DISCORD_CHANNEL_ID=YOUR_CHANNEL_ID

# --- RCON (must match your PZ server's RCON config in servertest.ini) -------
RCON_HOST=YOUR_SERVER_IP
RCON_PORT=27015
RCON_PASSWORD=YOUR_RCON_PASSWORD

# --- SFTP (the game server's file access) ----------------------------------
# The bot runs on a SEPARATE VPS and reads/writes the server's files over SFTP.
SFTP_HOST=YOUR_SERVER_IP
SFTP_PORT=22
SFTP_USER=YOUR_SFTP_USERNAME
# Use EITHER a password OR a key. Leave the other blank.
SFTP_PASSWORD=YOUR_SFTP_PASSWORD
# SFTP_KEY_PATH=/home/user/.ssh/id_ed25519

# Remote path to the Zomboid data folder (contains Lua/, Logs/, Server/).
# SFTP_LUA_DIR and SFTP_LOGS_DIR are derived from this automatically.
SFTP_ZOMBOID_ROOT=/server-data

# Overrides (optional — set only if the derived paths are wrong for your host):
SFTP_LUA_DIR=/server-data/Lua
SFTP_LOGS_DIR=/server-data/Logs
SFTP_SERVER_INI=/server-data/Server/pzserver.ini
# Server player database (known players). Indifferent Broccoli: /server-data/db/pzserver.db
SFTP_SERVER_DB=/server-data/db/pzserver.db
SFTP_MODS_DIR=/server-files/steamapps/workshop/content/108600

# --- Roles -----------------------------------------------------------------
# Role name required to use admin commands.
DEFAULT_ROLE=Admin
# Discord role names mapped to in-game chat colours (Rank 1 = lowest).
RANK_1=Fuel
RANK_2=Spark
RANK_3=Cinder
RANK_4=Flame
RANK_5=Blaze
RANK_6=Inferno

# --- Optional channels ------------------------------------------------------
# Auto-updating server status dashboard.
STATUS_CHANNEL_ID=YOUR_STATUS_CHANNEL_ID
# Bidirectional in-game <-> Discord chat relay.
CHAT_RELAY_CHANNEL_ID=YOUR_CHAT_RELAY_CHANNEL_ID
# Auto-updating horde survivor leaderboard.
HORDE_LEADERBOARD_CHANNEL_ID=YOUR_LEADERBOARD_CHANNEL_ID
# Server up/down + restart/mod-update banners (0 = fall back to DISCORD_CHANNEL_ID).
SERVER_NOTIFICATION_CHANNEL_ID=0
# Workshop-update / mod-update restart relay (0 = fall back to the notification channel).
WORKSHOP_UPDATE_CHANNEL_ID=0
WORKSHOP_UPDATE_ROLE_ID=0
# Channel for player death logs (0 = fall back to the main notification channel).
DEATH_LOGS_CHANNEL_ID=0
# Air-drop / supply-drop notifications (0 = fall back to the main channel).
AIRDROP_CHANNEL_ID=0
AIRDROP_ROLE_ID=0
# Horde-event notifications (0 = fall back to the main channel).
HORDE_CHANNEL_ID=0
HORDE_ROLE_ID=0
# Join/leave notifications (0 = fall back to the main channel).
JOIN_LEAVE_CHANNEL_ID=0

# --- Announcement banners (local image files, relative to the bot folder) ---
# Sent when the server comes online / restarts / updates mods / goes offline.
ANNOUNCE_UP_IMAGE=assets/server-up.png
ANNOUNCE_RESTART_IMAGE=assets/server-restarting.png
ANNOUNCE_MOD_UPDATE_IMAGE=assets/server-mod-update.png
ANNOUNCE_DOWN_IMAGE=assets/server-down.png

# @-mention this role in every server UP/DOWN announcement (e.g. the "Tambay" role).
# Get it via Discord Developer Mode -> right-click the role -> Copy ID. 0 = disabled.
NOTIFY_ROLE_ID=0

# --- Dashboard --------------------------------------------------------------
DASHBOARD_TITLE=PZ TAMBAYAN
# Local image files in assets/ — the bot uploads them to Discord and uses them automatically.
DASHBOARD_ICON_IMAGE=assets/profile-pic.png
DASHBOARD_BANNER_IMAGE=assets/profile-banner.png
# Player cap shown on the status card ("1 / 32").
MAX_PLAYERS=32
# How to render the status panel:
#   embed = native Discord embed (text is selectable/copyable)  <-- recommended
#   image = rendered PZ-themed card image (pretty, but not copyable)
STATUS_MODE=embed
# Optional: use a hosted URL instead of (or to override) the local file above.
# DASHBOARD_ICON_URL=https://cdn.discordapp.com/attachments/.../profile-pic.png
# DASHBOARD_BANNER_URL=https://cdn.discordapp.com/attachments/.../profile-banner.png

# --- Custom emoji (optional) ------------------------------------------------
# Upload custom emoji to your Discord server and paste the full string here.
# Format: <:name:ID> for static, <a:name:ID> for animated. Leave blank for defaults.
# EMOJI_HAPPY=<:pzhappy:1234567890>
# EMOJI_DIZZY=<:pzdizzy:1234567890>
# EMOJI_PANIC=<:pzpanic:1234567890>
# EMOJI_ANGRY=<:pzangry:1234567890>
# EMOJI_JEEVES=<:jeeves:1234567890>
# EMOJI_SPIFFO_POP=<a:spiffopop:1234567890>
# EMOJI_SPIFFO_WAVE=<:spiffowave:1234567890>
# EMOJI_SPIFFO_EDUCATE=<:spiffoeducate:1234567890>
# EMOJI_SPIFFO_KATANA=<:spiffokatana:1234567890>
# EMOJI_SPIFFO_STOP=<:spiffostop:1234567890>

# --- Bot-driven mod update checker + controlled restart ----------------------
# Polls the Steam Workshop every N seconds. When a subscribed item is updated it
# announces, then stops the server over RCON (save → kick → quit) so the host
# applies the update — deferred during a horde night if `restart_defer` is on.
# MOD_CHECK_INTERVAL_SECONDS = how often to poll the Workshop (default 300 = 5 min).
MOD_CHECK_INTERVAL_SECONDS=300
# MOD_CHECK_RESTART_DELAY_SECONDS = countdown length before the restart (default 300 = 5 min).
MOD_CHECK_RESTART_DELAY_SECONDS=300
# RESTART_KICK_NOTIFY_AT_SECONDS = seconds-remaining at which to announce the kick warning (default 120 = 2 min).
RESTART_KICK_NOTIFY_AT_SECONDS=120
# RESTART_SAVE_AT_SECONDS = seconds-remaining at which to RCON `save` (default 90 = 1:30).
RESTART_SAVE_AT_SECONDS=90
# RESTART_KICK_AT_SECONDS = seconds-remaining at which to kick players (default 60 = 1 min).
RESTART_KICK_AT_SECONDS=60
# MOD_UPDATE_STATE_PATH = where the update baseline is stored (a local JSON file).
MOD_UPDATE_STATE_PATH=mod_update_state.json
# STEAM_API_KEY = REQUIRED to detect updates to UNLISTED Workshop items (e.g. the
# server-only Death Log). Without it the keyless API can't see them; the bot then
# falls back to Steam's local manifest (appworkshop_108600.acf over SFTP), which
# LAGS and can only notice an unlisted update after the server has already booted
# and applied it. Get a key at https://steamcommunity.com/dev/apikey and set it
# here to detect unlisted mod updates live, like public ones.
# STEAM_API_KEY=

# Scheduled restart hours (UTC, 24h, comma-separated). The status panel shows a
# live countdown to the next one. Server restarts 4x daily at these UTC hours.
RESTART_SCHEDULE_UTC=4,10,16,22
